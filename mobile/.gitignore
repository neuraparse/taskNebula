.expo/
.expo-shared/
dist/
build/
coverage/
*.log
*.tsbuildinfo
.bundle/
.gradle/
.turbo/
pnpm-lock.yaml
pnpm-workspace.yaml

.env
.env.*
!.env.example

android/.gradle/
android/app/.cxx/
android/app/build/
android/build/
android/local.properties

ios/Pods/
ios/build/
ios/DerivedData/
ios/.xcode.env.local
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/
ios/*.xcodeproj/project.xcworkspace/xcuserdata/
