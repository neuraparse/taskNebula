{
  "name": "@tasknebula/mobile",
  "version": "0.14.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "dev": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "doctor": "react-native doctor",
    "build": "pnpm native:verify && pnpm ios:verify-bundle && node scripts/write-build-marker.mjs",
    "native:verify": "node scripts/verify-native.mjs && node scripts/verify-route-parity.mjs && node scripts/verify-query-keys.mjs",
    "routes:verify": "node scripts/verify-route-parity.mjs",
    "ios:verify-bundle": "node scripts/verify-ios-bundle.mjs",
    "android:verify-build": "node scripts/verify-android-build.mjs",
    "i18n:check": "node scripts/i18n-check.mjs && node scripts/sync-web-locale-translations.mjs --check && node scripts/i18n-fallback-check.mjs",
    "i18n:fallbacks:update": "node scripts/i18n-fallback-check.mjs --write-baseline",
    "i18n:sync-web": "node scripts/sync-web-locale-translations.mjs --write",
    "design:verify": "node scripts/verify-design-parity.mjs && node scripts/verify-brand-assets.mjs && node scripts/verify-native-classnames.mjs",
    "queries:verify": "node scripts/verify-query-keys.mjs",
    "openapi:sync": "node scripts/sync-openapi.mjs",
    "openapi:check": "node scripts/check-openapi-sync.mjs",
    "openapi:types": "pnpm dlx openapi-typescript@7.13.0 src/api/openapi.json -o src/api/openapi.generated.ts",
    "type-check": "tsc --noEmit",
    "lint": "pnpm native:verify && pnpm i18n:check && pnpm openapi:check && pnpm design:verify && eslint . --ext .ts,.tsx",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@livekit/react-native": "2.11.1",
    "@livekit/react-native-webrtc": "144.1.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-documents/picker": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.3",
    "@react-navigation/native": "^7.3.4",
    "@react-navigation/native-stack": "^7.17.6",
    "@tanstack/query-sync-storage-persister": "^5.101.0",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "i18next": "^26.3.3",
    "i18next-icu": "^2.4.3",
    "livekit-client": "2.20.0",
    "lucide-react-native": "^0.563.0",
    "react": "19.2.3",
    "react-hook-form": "^7.79.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "^3.0.2",
    "react-native-keychain": "^10.0.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "0.35.10",
    "react-native-reanimated": "^4.5.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "4.25.2",
    "react-native-sse": "1.2.1",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "^0.10.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-class-static-block": "7.29.7",
    "@babel/plugin-transform-export-namespace-from": "7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/codegen": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/gradle-plugin": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "29.7.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "hermes-compiler": "250829098.0.14",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
